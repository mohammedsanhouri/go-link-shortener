<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GoShort | Modern Link Shortener</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { background: #0f172a; color: white; font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="flex items-center justify-center min-h-screen">
    <div class="w-full max-w-md p-8 bg-slate-800 rounded-2xl shadow-2xl border border-slate-700">
        <h1 class="text-3xl font-bold mb-2 text-center text-blue-400">GoShort</h1>
        <p class="text-slate-400 text-center mb-8 text-sm">Mohammed's Cloud-Native Shortener</p>

        <div class="space-y-4">
            <input type="url" id="longUrl" placeholder="Paste your long URL here..." 
                   class="w-full px-4 py-3 bg-slate-900 border border-slate-700 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none transition-all">
            
            <button onclick="shortenLink()" id="btn"
                    class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-3 rounded-lg transition-colors flex justify-center items-center">
                Shorten Now
            </button>
        </div>

        <div id="resultBox" class="mt-8 hidden animate-fade-in">
            <p class="text-xs text-slate-400 uppercase tracking-widest mb-2 font-semibold">Your Short Link</p>
            <div class="flex items-center bg-slate-900 p-3 rounded-lg border border-blue-500/30">
                <input type="text" id="shortUrl" readonly class="bg-transparent w-full text-blue-300 outline-none">
                <button onclick="copyToClipboard()" class="ml-2 text-xs bg-slate-700 px-2 py-1 rounded hover:bg-slate-600">Copy</button>
            </div>
        </div>
    </div>

    <script>
        const API_URL = "${API_URL}";

        async function shortenLink() {
            const longUrl = document.getElementById('longUrl').value;
            const btn = document.getElementById('btn');
            const resultBox = document.getElementById('resultBox');

            if (!longUrl) return alert("Please paste a URL!");

            btn.innerText = "Processing...";
            btn.disabled = true;

            try {
                const response = await fetch(`${API_URL}/shorten`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ long_url: longUrl })
                });

                const data = await response.json();
                
                if (data.short_url) {
                    const fullShortUrl = `${API_URL}/$${data.short_url}`;
                    document.getElementById('shortUrl').value = fullShortUrl;
                    resultBox.classList.remove('hidden');
                }
            } catch (err) {
                alert("Error connecting to API. Check CORS settings!");
            } finally {
                btn.innerText = "Shorten Now";
                btn.disabled = false;
            }
        }

        function copyToClipboard() {
            const copyText = document.getElementById("shortUrl");
            copyText.select();
            document.execCommand("copy");
            alert("Copied to clipboard!");
        }
    </script>
</body>
</html>